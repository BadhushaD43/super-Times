# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/ecom
# PostgreSQL schema name (default: public)
DB_SCHEMA=ecom

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Admin credentials ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# ── OTP ───────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5

# ── SMTP ──────────────────────────────────────────────────────────
# For Gmail: enable 2FA and create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated exact origins
ALLOWED_ORIGINS=https://your-frontend.example.com
# Regex for dynamic preview URLs (e.g. Vercel)
ALLOWED_ORIGIN_REGEX=^https://your-app-.*\.vercel\.app$
